{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex usage meter error v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "error"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "error": {
      "enum": [
        "unauthorized",
        "not_found",
        "method_not_allowed",
        "bad_request",
        "snapshot_invalid",
        "snapshot_oversized",
        "snapshot_version",
        "snapshot_unreadable"
      ]
    }
  }
}

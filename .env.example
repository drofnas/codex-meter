# Copy to .env; values here are safe templates, not a running configuration.
METER_AUTH_FILE=~/.codex/auth.json
METER_DATA_DIR=.local/data
METER_STATE_DIR=.local/state
# Blank means discover the Mac's IANA zone once at collector startup.
METER_TIMEZONE=
METER_COLLECTION_SECONDS=60
METER_STALE_SECONDS=180
METER_SOURCE_TIMEOUT_SECONDS=10
# Choose this Mac's LAN address explicitly when connecting the physical CYD.
METER_API_BIND_ADDRESS=127.0.0.1
METER_API_PORT=8080
# Generate a dedicated 32-byte random token, encoded as 64 lowercase hex digits.
# Empty is deliberately invalid. Never put a Codex credential here.
METER_API_TOKEN=
